{
  "name": "agent-context-across-platform",
  "version": "0.3.0",
  "keywords": ["pi-package", "session-handoff", "onedrive"],
  "pi": { "extensions": ["./extensions/pi-session.ts"] },
  "peerDependencies": { "@earendil-works/pi-coding-agent": "*" },
  "peerDependenciesMeta": { "@earendil-works/pi-coding-agent": { "optional": true } },
  "private": true,
  "description": "Reviewed session bundles shared through OneDrive and SharePoint.",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/cli.js serve",
    "mcp": "node src/mcp-server.js",
    "share": "node src/cli.js share",
    "inspect": "node src/cli.js inspect",
    "assess": "node src/cli.js assess",
    "doctor": "node src/cli.js doctor",
    "demo": "node scripts/demo-reviewed.js",
    "resume": "node src/cli.js resume",
    "clone": "node src/cli.js clone",
    "login": "node src/cli.js login",
    "configure": "node src/cli.js configure",
    "test": "node --test"
  },
  "dependencies": {
    "@azure/msal-node": "6.0.1",
    "@azure/msal-node-extensions": "5.5.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.6.1"
  }
}
